{
  "name": "@resume/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "ingest": "tsx src/ingest.ts",
    "migrate": "tsx src/migrate-cli.ts",
    "feedback:report": "tsx src/feedback-report.ts",
    "ip:reset": "tsx src/ip-reset-cli.ts",
    "eval:retrieval": "tsx src/eval-retrieval.ts",
    "eval:security": "tsx src/eval-security.ts",
    "prebuild": "pnpm --filter @resume/retrieval build",
    "build": "tsc -p tsconfig.json",
    "pretypecheck": "pnpm --filter @resume/retrieval build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --exclude test/chat.test.ts --exclude test/pg-abuse-protection.test.ts --exclude test/pg-email-auth.test.ts --exclude test/pg-admin.test.ts",
    "test:integration": "vitest run test/chat.test.ts test/pg-abuse-protection.test.ts test/pg-email-auth.test.ts test/pg-admin.test.ts"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.99.1",
    "@earendil-works/pi-ai": "0.99.1",
    "@resume/retrieval": "workspace:*",
    "bcryptjs": "^3.0.3",
    "express": "^5.2.1",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.23.0",
    "typebox": "1.3.27"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^22.19.0",
    "@types/pg": "^8.23.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
