# 复制为 resume-agent/.env。不要把真密钥提交进仓库。

# DeepSeek 对话密钥。pi-ai 的 deepseek 提供方会自动读取这个变量。
DEEPSEEK_API_KEY=

# 可选。不填时从已安装的 pi-ai deepseek 目录里选模型：
# 优先 reasoning 为 false 的快速模型；当前 0.99.1 目录里没有这种模型，因此默认 deepseek-flash。
# 可选值以 getBuiltinModels("deepseek") 为准，例如 deepseek-flash、deepseek-v4-pro。
DEEPSEEK_MODEL=

# OpenAI 兼容的 /v1/embeddings。默认是硅基流动上的 BAAI/bge-m3（1024 维）。
# 入库要求返回 1024 维，和迁移里的 vector(1024) 一致。维度变了要先改迁移再 pnpm ingest。
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_API_KEY=
EMBEDDING_TIMEOUT_MS=15000

# 后端端口。前端开发服务器默认把 /api 代理到这里。
PORT=8787

# Postgres + pgvector。本地可先 docker compose up -d。
# 向量列是 vector(1024)，对应 BAAI/bge-m3。换模型若维度变化，要先改迁移。
DATABASE_URL=postgres://resume:resume@127.0.0.1:5432/resume
EMBEDDING_DIMENSION=1024

# 仅在 HTTPS 部署时设为 1，给访客 cookie 加上 Secure。
COOKIE_SECURE=0

# 邮箱验证是聊天的必经步骤，CHAT_MOCK=1 也不能绕过。未配置时仅可浏览公开简历。
# 本地没有自有域名、也还没开通阿里云发信地址时：
#   保持 EMAIL_DEV_MAILER=1，并填写至少 32 字符的 EMAIL_AUTH_SECRET。
#   验证码打印在后端终端，形如「[email-dev] 收件邮箱 … 验证码 ……」。
#   不调用阿里云，不出现在接口响应或浏览器里。AccessKey 可以留空。
# 有真实域名后：把 EMAIL_DEV_MAILER 改为 0，把 ALIYUN_DM_ACCOUNT_NAME 换成控制台里
#   已验证域名下的「触发类」发信地址，并填上仅授予 dm:SingleSendMail 的 RAM AccessKey。
#   发码和校验代码不用改。生产环境不要打开 EMAIL_DEV_MAILER。
EMAIL_DEV_MAILER=1
# 占位发信地址，不是真实域名，不能用来真发信。上线时整行替换成控制台里的触发类发信地址。
ALIYUN_DM_ACCOUNT_NAME=noreply@mail.example.com
# 阿里云邮件推送：中国杭州区域。本地开发开关打开时可以留空。
# 使用仅授予 dm:SingleSendMail 的 RAM 身份，勿使用主账号 AccessKey。
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=
# 使用 STS 临时凭证时填写，否则留空。
ALIBABA_CLOUD_SECURITY_TOKEN=
# 独立随机密钥，至少 32 字符，各实例必须一致且保持稳定。
# 生成：node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
EMAIL_AUTH_SECRET=
EMAIL_DAILY_SEND_LIMIT=100
EMAIL_DAILY_SEND_LIMIT_PER_IP=20

# 可选。简历原文和静态文件的位置。
# RESUME_DIR=data/resume
# PUBLIC_DIR=data/public

# 公开聊天接口按 IP 限流。
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=20

# 防刷：Postgres 持久化共享，重启/多实例不重置。下面均为请求数/并发数，不是 Token 或金额。
API_RATE_LIMIT_MAX=120
CHAT_VISITOR_RATE_LIMIT_MAX=10
CHAT_MAX_CONCURRENT=4
CHAT_MAX_CONCURRENT_PER_IP=2
CHAT_MAX_CONCURRENT_PER_VISITOR=1
CHAT_DAILY_REQUEST_LIMIT=300
CHAT_DAILY_REQUESTS_PER_IP=50
CHAT_DAILY_REQUESTS_PER_VISITOR=30
QUOTA_TIME_ZONE=Asia/Singapore
CHAT_TURN_TIMEOUT_MS=120000
# 同一 IP 首次成功提问后连续开放 15 分钟；到期永久关闭。
# 可在站长后台「解除禁止」，或在服务器执行 pnpm ip:reset。ip:reset 只清时段，不移出永久黑名单。
# 只影响新建时段，修改变量不会自动延长数据库中已有时段。
CHAT_IP_WINDOW_MS=900000
# 时段到期后多久自动恢复（毫秒）。0 表示永久关闭，只能手动解除。
CHAT_IP_WINDOW_COOLDOWN_MS=0
# 站长账号由命令行按这两项创建：pnpm admin:create。网页上没有注册入口。
# 中国大陆 11 位手机号；密码 8 到 72 位。改了再执行一次会更新账号，并作废已有的站长登录。
ADMIN_PHONE=
ADMIN_PASSWORD=
# Token 和费用总额度请在模型平台控制台另行设置。

# 仅本地看界面。设为 1 时 /api/chat 返回预设 SSE，不调用模型，也不需要密钥。
CHAT_MOCK=0
# 演示模式下每条正文和工具结束之间的等待，单位毫秒。
CHAT_MOCK_DELAY_MS=350

# 单次模型请求超时，单位毫秒。默认 90 秒。到点后这条回答记为错误，可以重试。
MODEL_TIMEOUT_MS=90000

# 开发时前端地址，逗号分隔。
CORS_ORIGIN=http://127.0.0.1:5174,http://localhost:5174

# 部署在反向代理后面、需要按 X-Forwarded-For 识别访客时设为 1。
TRUST_PROXY=0
