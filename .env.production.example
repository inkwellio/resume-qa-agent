# 复制为 .env.production 后填写：cp .env.production.example .env.production
# 这个文件不要提交进仓库。DATABASE_URL 由 docker-compose.prod.yml 内部拼好，不用填。

# 必填：DeepSeek 对话密钥
DEEPSEEK_API_KEY=
# 必填：硅基流动（或其他 OpenAI 兼容）向量接口密钥
EMBEDDING_API_KEY=

# 必填：数据库密码。deploy.sh 发现为空时会自动生成一个随机密码写回本文件。
POSTGRES_PASSWORD=
POSTGRES_USER=resume
POSTGRES_DB=resume

# 对外 HTTP 端口，默认 80
HTTP_PORT=80

# 可选：留空自动选模型
DEEPSEEK_MODEL=
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSION=1024
EMBEDDING_TIMEOUT_MS=15000

# 配好 HTTPS 后改为 1
COOKIE_SECURE=0
# 生产保持 0 或不设置。设为 1 只会把验证码打在进程日志里，不会调用阿里云。
EMAIL_DEV_MAILER=0
# 邮箱验证必填；杭州区域 DirectMail 的「触发类」发信地址。不要填占位域名。
# RAM AccessKey 仅授权 dm:SingleSendMail；密钥不要提交至仓库。
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=
ALIBABA_CLOUD_SECURITY_TOKEN=
ALIYUN_DM_ACCOUNT_NAME=
# 独立随机密钥，至少 32 字符；各实例必须一致。
EMAIL_AUTH_SECRET=
EMAIL_DAILY_SEND_LIMIT=100
EMAIL_DAILY_SEND_LIMIT_PER_IP=20
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=20
API_RATE_LIMIT_MAX=120
CHAT_VISITOR_RATE_LIMIT_MAX=10
CHAT_MAX_CONCURRENT=4
CHAT_MAX_CONCURRENT_PER_IP=2
CHAT_MAX_CONCURRENT_PER_VISITOR=1
CHAT_DAILY_REQUEST_LIMIT=300
CHAT_DAILY_REQUESTS_PER_IP=50
CHAT_DAILY_REQUESTS_PER_VISITOR=30
QUOTA_TIME_ZONE=Asia/Singapore
CHAT_TURN_TIMEOUT_MS=120000
# 同一 IP 共用连续 15 分钟，过期不按日恢复。
# 站长后台「解除禁止」会清时段并移出永久黑名单；ip:reset 只清时段。
CHAT_IP_WINDOW_MS=900000
# 站长在浏览器打开 /admin/setup 注册手机号和密码。不要再配置 ADMIN_TOKEN。
# 上述为服务端请求配额；Token 和费用总额度由模型平台控制台管理。
MODEL_TIMEOUT_MS=90000
